# URL database Prisma untuk development lokal (SQLite).
DATABASE_URL="file:./dev.db"

# Secret sesi aplikasi dan signed URL file privat; wajib nilai acak di production.
AUTH_SECRET="replace-with-a-random-local-secret"

# Direktori penyimpanan lokal untuk file selain bukti transfer.
STORAGE_ROOT="./storage"

# Kunci hex 64 karakter untuk enkripsi BYOK; kosong memakai kunci sementara saat development.
CRYPTO_KEY=""

# Email akun Super-Admin yang dibuat oleh script seed.
SUPER_ADMIN_EMAIL="admin@example.local"
# Nama akun Super-Admin yang dibuat oleh script seed.
SUPER_ADMIN_NAME="Local Super Admin"
# Password awal akun Super-Admin untuk script seed.
SUPER_ADMIN_INITIAL_PASSWORD="change-this-local-password"

# Secret akses API MCP; wajib diisi pada production.
MCP_SECRET="replace-with-a-random-local-secret"
# Secret endpoint maintenance terjadwal; wajib diisi pada production.
CRON_SECRET=""

# Secret untuk memverifikasi signature webhook GitHub.
GITHUB_WEBHOOK_SECRET="replace-with-a-random-local-secret"

# Host SMTP; kosong memakai local email outbox.
SMTP_HOST=""
# Port koneksi SMTP.
SMTP_PORT="587"
# Gunakan TLS implisit bila bernilai true.
SMTP_SECURE="false"
# Username autentikasi SMTP.
SMTP_USER=""
# Password autentikasi SMTP.
SMTP_PASS=""
# Nama pengirim dan alamat email pada pesan keluar.
SMTP_FROM="Althentic.Dev <no-reply@localhost>"

# API key URLBox untuk screenshot inspeksi; provider ini diprioritaskan.
URLBOX_KEY=""
# API key ScreenshotOne sebagai fallback provider screenshot.
SCREENSHOTONE_KEY=""

# Endpoint S3-compatible khusus branch Neon, tanpa nama bucket di URL.
AWS_ENDPOINT_URL_S3="https://<branch-id>.storage.<cell>.<region>.aws.neon.tech"
# Access key Neon Object Storage dengan izin baca/tulis bucket receipt.
AWS_ACCESS_KEY_ID=""
# Secret access key Neon Object Storage.
AWS_SECRET_ACCESS_KEY=""
# Region endpoint Neon, umumnya us-east-2.
AWS_REGION="us-east-2"

# Nama bucket private khusus bukti transfer.
NEON_STORAGE_BUCKET_RECEIPTS="receipts"

# Mode runtime Next.js.
NODE_ENV="development"
