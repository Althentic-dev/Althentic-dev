# Local development only. Never put production credentials in this file.

# Prisma SQLite database, relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Required in production for sessions and signed file URLs.
# Use a unique, high-entropy value. Local development may use the fallback.
AUTH_SECRET="replace-with-a-random-local-secret"

# Local file storage path, relative to the project root
STORAGE_ROOT="./storage"

# Optional 64-character hexadecimal key for persistent local BYOK encryption.
# Leave empty to use a temporary key generated by the application.
CRYPTO_KEY=""

# Local seed account. Change this password before running the seed script.
SUPER_ADMIN_EMAIL="admin@example.local"
SUPER_ADMIN_NAME="Local Super Admin"
SUPER_ADMIN_INITIAL_PASSWORD="change-this-local-password"

# Required in production for MCP and scheduled tasks.
MCP_SECRET="replace-with-a-random-local-secret"
CRON_SECRET=""

# Required in production to verify GitHub webhook signatures.
GITHUB_WEBHOOK_SECRET="replace-with-a-random-local-secret"

# Optional SMTP settings. Leave SMTP_HOST empty to use the local email outbox.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Althentic.Dev <no-reply@localhost>"

# Optional product inspection screenshot provider keys
URLBOX_KEY=""
SCREENSHOTONE_KEY=""

NODE_ENV="development"
